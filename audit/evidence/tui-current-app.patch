+#[derive(Debug, Clone, PartialEq, Eq)]
+#[cfg_attr(not(feature = "real"), allow(dead_code))]
+enum OauthUiEvent {
+    /// The flow is ready for a pasted authorization code / redirect URL.
+    NeedCode {
